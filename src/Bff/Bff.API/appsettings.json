{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 1048576
    }
  },
  "Keycloak": {
    "Authority": "http://localhost:8081/realms/Verx",
    "Issuer": "http://localhost:8081/realms/Verx",
    "Audience": "verx-api",
    "RequireHttpsMetadata": false,
    "TokenEndpoint": "http://localhost:8081/realms/Verx/protocol/openid-connect/token",
    "LogoutEndpoint": "http://localhost:8081/realms/Verx/protocol/openid-connect/logout",
    "ClientId": "verx-bff",
    "ClientSecret": "dev-only-bff-secret"
  },
  "RateLimiting": {
    "PermitLimitPorUsuario": 100,
    "ReposicaoPorSegundo": 100,
    "PermitLimitGlobal": 500,
    "LoginPorMinuto": 20
  },
  "Sessao": {
    "Habilitada": true,
    "NomeDoCookie": "verx.sessao",
    "InatividadeMinutos": 30,
    "RenovarAntesDeExpirarSegundos": 60,
    "UrlPublicaDoIdp": "http://localhost:8081",
    "UrlInternaDoIdp": "http://localhost:8081",
    "Realm": "Verx",
    "RedisConnectionString": "localhost:6379,abortConnect=false,connectTimeout=500,syncTimeout=500"
  },
  "Cors": {
    "Origens": []
  },
  "ReverseProxy": {
    "Routes": {
      "lancamentos": {
        "ClusterId": "lancamentos",
        "AuthorizationPolicy": "AcessoContaDaRota",
        "RateLimiterPolicy": "verx-padrao",
        "Match": { "Path": "/api/contas/{contaId:guid}/lancamentos/{**resto}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "saldo": {
        "ClusterId": "consolidado",
        "AuthorizationPolicy": "AcessoContaDaRota",
        "RateLimiterPolicy": "verx-padrao",
        "Match": { "Path": "/api/contas/{contaId:guid}/saldo" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      },
      "saldo-diario": {
        "ClusterId": "consolidado",
        "AuthorizationPolicy": "AcessoContaDaRota",
        "RateLimiterPolicy": "verx-padrao",
        "Match": { "Path": "/api/contas/{contaId:guid}/saldo-diario/{**data}" },
        "Transforms": [ { "RequestHeaderOriginalHost": "true" } ]
      }
    },
    "Clusters": {
      "lancamentos": {
        "Destinations": { "principal": { "Address": "http://localhost:5100/" } },
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyAndUnknown",
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:03", "Policy": "ConsecutiveFailures", "Path": "/health/live" },
          "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:00:10" }
        }
      },
      "consolidado": {
        "Destinations": { "principal": { "Address": "http://localhost:5101/" } },
        "HttpRequest": { "ActivityTimeout": "00:00:30" },
        "HealthCheck": {
          "AvailableDestinationsPolicy": "HealthyAndUnknown",
          "Active": { "Enabled": true, "Interval": "00:00:10", "Timeout": "00:00:03", "Policy": "ConsecutiveFailures", "Path": "/health/live" },
          "Passive": { "Enabled": true, "Policy": "TransportFailureRate", "ReactivationPeriod": "00:00:10" }
        }
      }
    }
  },
  "AllowedHosts": "*"
}
